# Render backend only. Get the Session pooler URL from Supabase > Connect.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres
# Only needed when the database uses a CA outside the system trust store:
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
PORT=3000
